generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum LogicType {
  ALL
  N_OF
  COURSE
  UNITS
  TEXT_RULE
}

enum CredentialCategory {
  HONOURS
  JOINT_HONOURS
  GENERAL
  MINOR
  SPECIALIZATION
  OPTION
  DOUBLE_DEGREE
}

enum CoopSequence {
  NO_COOP
  SEQUENCE_1
  SEQUENCE_2
  SEQUENCE_3
  SEQUENCE_4
  CUSTOM
}

enum CourseStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  FAILED
  DROPPED
  BACKLOG
}

enum RequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── Auth (NextAuth.js) ─────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  isGuest        Boolean   @default(false)
  guestExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]
  plans          Plan[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Academic Structure ─────────────────────────────────────────────────────

model Faculty {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  subjects  Subject[]
  programs  Program[]
}

model Subject {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  facultyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses   Course[]
}

model Course {
  id                 String        @id @default(cuid())
  kualiId            String        @unique
  code               String        @unique
  number             String
  subjectId          String
  name               String
  description        String?
  units              Float
  antiRequisiteText    String?
  specialCourseGrading String?
  specialConsentToAdd  String?
  specialConsentToDrop String?
  crossListedWith      String[]      @default([])
  prerequisiteRootId String?
  corequisiteRootId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  subjectRef         Subject       @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prerequisiteRoot   Requirement?  @relation("CoursePrerequisite", fields: [prerequisiteRootId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  corequisiteRoot    Requirement?  @relation("CourseCorequisite", fields: [corequisiteRootId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planCourses        PlanCourse[]
  requirementRefs    Requirement[] @relation("RequirementCourse")
}

// ─── Requirements (recursive tree) ─────────────────────────────────────────

model Requirement {
  id                 String    @id @default(cuid())
  parentId           String?
  logicType          LogicType
  label              String?
  n                  Int?
  courseId           String?
  courseCode         String?
  minGradeRequired   Int?
  unitsRequired      Float?
  subjectRestriction String?
  levelRestriction   String?
  minAverage         Float?
  maxFailures        Int?
  failureRestriction String?
  concentrationType  String?
  text               String?
  displayOrder       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Self-referential tree
  parent   Requirement?  @relation("RequirementTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Requirement[] @relation("RequirementTree")

  // Course leaf node link
  course Course? @relation("RequirementCourse", fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Inverse relations (things pointing TO this requirement as a root)
  coursePrerequisites Course[]             @relation("CoursePrerequisite")
  courseCorequisites  Course[]             @relation("CourseCorequisite")
  sectionRoot         RequirementSection?  @relation("SectionRequirement")

  // Cache entries
  planRequirementCaches PlanRequirementCache[]
}

// ─── Programs & Degrees ─────────────────────────────────────────────────────

model Program {
  id        String   @id @default(cuid())
  kualiId   String   @unique
  name      String   @unique
  facultyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  degrees   Degree[]
}

model Degree {
  id                      String             @id @default(cuid())
  kualiId                 String
  programId               String
  name                    String
  credentialType          String
  credentialCategory      CredentialCategory
  systemsOfStudy          String?
  declarationRequirements String?
  minimumAverages         String?
  graduationRequirements  String?
  additionalConstraints   String?
  studentAudience         String?
  notes                   String?
  offeredBy               String?
  academicCalendarYear    String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  program                 Program            @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sections                RequirementSection[]
  planDegrees             PlanDegree[]

  @@unique([kualiId, academicCalendarYear])
}

model RequirementSection {
  id                String       @id @default(cuid())
  degreeId          String
  label             String
  displayOrder      Int          @default(0)
  requirementRootId String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  degree            Degree       @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  requirementRoot   Requirement? @relation("SectionRequirement", fields: [requirementRootId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── User Plans ─────────────────────────────────────────────────────────────

model Plan {
  id                   String       @id @default(cuid())
  userId               String
  name                 String
  academicCalendarYear String?
  coopSequence         CoopSequence @default(NO_COOP)
  customTerms          Json         @default("[]")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses              PlanCourse[]
  degrees              PlanDegree[]

  @@unique([name, userId])
}

model PlanDegree {
  id               String                 @id @default(cuid())
  planId           String
  degreeId         String
  createdAt        DateTime               @default(now())
  plan             Plan                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  degree           Degree                 @relation(fields: [degreeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requirementCache PlanRequirementCache[]

  @@unique([planId, degreeId])
}

model PlanCourse {
  id           String       @id @default(cuid())
  planId       String
  courseId     String
  term         String
  status       CourseStatus
  gradeLabel   String?
  gradeNumeric Float?
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([planId, courseId])
}

model PlanRequirementCache {
  id            String            @id @default(cuid())
  planDegreeId  String
  requirementId String
  status        RequirementStatus
  progress      Float
  updatedAt     DateTime          @updatedAt
  planDegree    PlanDegree        @relation(fields: [planDegreeId], references: [id], onDelete: Cascade)
  requirement   Requirement       @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([planDegreeId, requirementId])
}
